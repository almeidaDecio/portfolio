---
import { icon } from "./icons";
import { useTranslations } from "../i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pathname: string;
  sections?: { name: string; id: string }[];
  lang?: string;
}

const { title, description, pathname: rawPathname, sections, lang } = Astro.props;
const pathname = rawPathname.replace(/\/$/, "") || "/";
const locale = lang || Astro.currentLocale || "pt";
const { t } = useTranslations(locale);

const ptPath = pathname.replace(/^\/en/, "") || "/";
const enPath = pathname.startsWith("/en") ? pathname : (pathname === "/" ? "/en" : `/en${pathname}`);

const pageTitle = title
  ? `${title} — Décio D'Almeida | Product Designer`
  : t("layout.siteTitle");

const pageDescription = description || t("layout.siteDescription");

const breadcrumb = new Map([
  ["/", t("layout.breadcrumb.perfil")],
  ["/experiencias", t("layout.breadcrumb.experiencias")],
  ["/cases", t("layout.breadcrumb.cases")],
  ["/formacao", t("layout.breadcrumb.formacao")],
  ["/skills", t("layout.breadcrumb.skills")],
  ["/contato", t("layout.breadcrumb.contato")],
]);

const caseName = new Map([
  ["/case_softfocus_novo", t("layout.caseNames.softfocus")],
  ["/case_gamegather", t("layout.caseNames.gamegather")],
  ["/case_amigo_secreto", t("layout.caseNames.amigoSecreto")],
  ["/case_hurst_capital", t("layout.caseNames.hurstCapital")],
]);

const navItems = [
  { title: t("layout.nav.perfil"), url: "/", icon: "user" },
  { title: t("layout.nav.experiencias"), url: "/experiencias", icon: "briefcase" },
  { title: t("layout.nav.cases"), url: "/cases", icon: "folderKanban" },
  { title: t("layout.nav.formacao"), url: "/formacao", icon: "graduationCap" },
  { title: t("layout.nav.skills"), url: "/skills", icon: "sparkles" },
  { title: t("layout.nav.contato"), url: "/contato", icon: "mail" },
];

function localeUrl(path: string): string {
  if (locale === "pt") return path;
  if (path === "/") return "/en";
  return `/en${path}`;
}

const isActive = (url: string) =>
  locale === "pt"
    ? url === "/" ? pathname === "/" : pathname.startsWith(url)
    : url === "/"
      ? pathname.replace("/en", "") === ""
      : pathname.replace("/en", "").startsWith(url);

const isHome = locale === "pt" ? pathname === "/" : pathname.replace("/en", "") === "";
const isCase = caseName.has(pathname) || caseName.has(pathname.replace("/en", ""));

const cleanPath = pathname.replace(/^\/en/, "") || "/";
const currentLabel = isCase
  ? caseName.get(pathname) || caseName.get(cleanPath)
  : breadcrumb.get(pathname) || breadcrumb.get(cleanPath);

function breadcrumbSchema() {
  const parts = [{ name: t("layout.breadcrumb.portfolio"), path: localeUrl("/") }];
  if (cleanPath.startsWith("/case_") && currentLabel) {
    parts.push({ name: t("layout.breadcrumb.cases"), path: localeUrl("/cases") });
    parts.push({ name: currentLabel, path: pathname });
  } else if (!isHome && currentLabel) {
    parts.push({ name: currentLabel, path: pathname });
  }
  return parts;
}
const crumbs = breadcrumbSchema();
---

<!DOCTYPE html>
<html lang={locale === "en" ? "en" : "pt-BR"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Décio D'Almeida" />
    <meta property="og:title" content="Décio D'Almeida — Product Designer" />
    <meta property="og:description" content={t("layout.ogDescription")} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://portfolio.decio-almeida-1969.workers.dev/linkedin.png" />
    <meta property="og:url" content="https://portfolio.decio-almeida-1969.workers.dev/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🖤</text></svg>" />
    <script is:inline>
      document.documentElement.classList.toggle("dark", localStorage.getItem("theme") === "dark");
    </script>
  </head>
  <body>
    <div id="layout" class="flex min-h-screen w-full bg-background">
      <!-- Sidebar -->
      <aside
        id="sidebar"
        class="fixed left-0 top-0 z-40 flex h-screen flex-col border-r border-sidebar-border bg-sidebar transition-all duration-300 md:sticky md:translate-x-0"
        style="width: 16rem"
      >
        <div class="flex items-center gap-3 px-4 py-3">
          <a href={localeUrl("/")} class="flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-primary-foreground font-semibold text-sm">
              D
            </div>
            <div class="flex flex-col leading-tight">
              <span class="text-sm font-semibold tracking-tight text-sidebar-foreground">
                {t("layout.sidebar.name")}
              </span>
              <span class="text-xs text-muted-foreground">
                {t("layout.sidebar.role")}
              </span>
            </div>
          </a>
        </div>

        <nav class="flex-1 px-2 pt-10">
          <ul class="space-y-1">
            {navItems.map((item) => (
              <li>
                <a
                  href={localeUrl(item.url)}
                  class="flex h-10 items-center gap-3 rounded-md px-3 text-sm font-medium transition-colors"
                  class:list={{
                    "bg-sidebar-accent text-sidebar-accent-foreground": isActive(item.url),
                    "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground": !isActive(item.url),
                  }}
                >
                  <span class="shrink-0 [&>svg]:h-[18px] [&>svg]:w-[18px]" set:html={icon(item.icon)}>
                  </span>
                  <span>{item.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <!-- Main area -->
      <div class="flex flex-1 flex-col min-w-0">
        <!-- Header -->
        <header class="sticky top-0 z-30 flex h-14 items-center gap-3 border-b border-border bg-background/80 px-4 backdrop-blur-md md:px-6">
          <button
            id="sidebar-toggle"
            class="flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground transition-colors -ml-1"
            aria-label={t("layout.header.toggleSidebar")}
          >
            <span class="md:hidden [&>svg]:h-5 [&>svg]:w-5" set:html={icon("menu")}></span>
            <span class="hidden md:inline" set:html={icon("panelLeft")}></span>
          </button>

          <div class="h-5 w-px bg-border"></div>

          <a href={ptPath} class="text-xs tracking-[0.18em] transition-colors text-muted-foreground hover:text-foreground" style={{ fontWeight: locale === "pt" ? 800 : 500 }}>
            PT
          </a>
          <span class="text-xs text-muted-foreground/40">/</span>
          <a href={enPath} class="text-xs tracking-[0.18em] transition-colors text-muted-foreground hover:text-foreground" style={{ fontWeight: locale === "en" ? 800 : 500 }}>
            EN
          </a>
          <span class="text-xs text-muted-foreground/50">|</span>
          <a href={localeUrl("/")} class="text-xs font-medium tracking-[0.18em] text-muted-foreground hover:text-foreground transition-colors">
            {t("layout.header.portfolioLabel")}
          </a>

          {!isHome && crumbs.slice(1).map((crumb, j, arr) => {
            const isLast = j === arr.length - 1;
            return (
              <span class="inline-flex items-center gap-1">
                <span class="text-xs text-muted-foreground/50">/</span>
                {isLast ? (
                  <span class="text-xs font-medium tracking-[0.18em] text-foreground">{crumb.name}</span>
                ) : (
                  <a href={crumb.path} class="text-xs font-medium tracking-[0.18em] text-muted-foreground hover:text-foreground transition-colors">{crumb.name}</a>
                )}
              </span>
            );
          })}
          {!isHome && <span class="hidden md:contents">
            {sections && sections.map((s) => (
              <span class="inline-flex items-center gap-1">
                <span class="text-xs text-muted-foreground/50">/</span>
                <a href={`#${s.id}`} class="text-xs font-medium tracking-[0.18em] text-muted-foreground hover:text-foreground transition-colors">{s.name}</a>
              </span>
            ))}
          </span>}
        </header>

        <!-- Main content -->
        <main class="flex-1">
          <slot />
        </main>

        <!-- Footer -->
        <footer class="border-t border-border px-6 py-8 text-xs text-muted-foreground">
          <div class="flex max-w-6xl px-6 md:px-20 lg:px-10 flex-col items-start justify-between gap-3 md:flex-row md:items-center">
            <span>{t("layout.footer")}</span>
          </div>
        </footer>
      </div>
    </div>

    <script>
      const sidebar = document.getElementById("sidebar");
      const toggle = document.getElementById("sidebar-toggle");
      const main = document.querySelector("#layout > div");

      let sidebarOpen = window.innerWidth >= 768;
      if (!sidebarOpen) {
        sidebar.style.transform = "translateX(-100%)";
      }

      if (toggle && sidebar) {
        toggle.addEventListener("click", () => {
          sidebarOpen = !sidebarOpen;
          if (sidebarOpen) {
            sidebar.style.transform = "translateX(0)";
            sidebar.style.width = "16rem";
            main.style.marginLeft = "0";
          } else {
            sidebar.style.transform = "translateX(-100%)";
          }
        });
      }

      // Close sidebar on mobile after nav click
      document.querySelectorAll("#sidebar nav a").forEach((link) => {
        link.addEventListener("click", () => {
          if (window.innerWidth < 768) {
            sidebar.style.transform = "translateX(-100%)";
            sidebarOpen = false;
          }
        });
      });
    </script>
  </body>
</html>
