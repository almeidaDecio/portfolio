---
import Layout from "../../components/Layout.astro";
import PageContainer from "../../components/PageContainer.astro";
import SectionHeader from "../../components/SectionHeader.astro";

const items = [
  {
    type: "Bachelor's Degree",
    title: "Advertising & Visual Communication",
    institution: "UNIP — Universidade Paulista (1988 – 1992)",
    period: "",
    description:
      "Established my core foundations in visual storytelling, brand strategy, typography, and creative execution — principles that continue to guide my digital design philosophy.",
  },
  {
    type: "Postgraduate Degree",
    title: "Art History",
    institution: "FAAP — Fundação Armando Alvares Penteado (2013 – 2015)",
    period: "",
    description:
      "Refined my visual library, aesthetic criticism, and deep understanding of composition, color theory, and visual communication.",
  },
  {
    type: "Professional Certifications",
    title: "Interaction Design Foundation (IxDF)",
    institution: "Design Thinking: The Ultimate Guide (2023)\nUser Experience: The Beginner's Guide (2023)",
    period: "2023",
    description:
      "Structured my transition into UX research, establishing formal frameworks for user-centric problem-solving, product discovery, and rapid prototyping.",
  },
];
---

<Layout
  pathname={Astro.url.pathname}
  title="Education"
  description="Academic background, courses, and certifications in Product Design and research."
  lang="en"
>
  <PageContainer>
    <section class="-mt-6">
      <SectionHeader title="Education & Credentials" />

      <ul class="mt-4 space-y-6 md:mt-8">
        {items.map((it, i) => (
          <li
            class="animate-fade-up"
            style={`animation-delay: ${i * 0.06}s`}
          >
            <article class="rounded-2xl border border-border bg-card p-6 hover-lift md:p-8">
              {it.period && (
                <div class="flex flex-wrap items-center gap-2 text-[11px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
                  <span>{it.type}</span>
                  <span class="h-1 w-1 rounded-full bg-muted-foreground" />
                  <span>{it.period}</span>
                </div>
              )}
              {!it.period && (
                <div class="flex flex-wrap items-center gap-2 text-[11px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
                  <span>{it.type}</span>
                </div>
              )}

              <h3 class="mt-3 text-xl font-semibold tracking-tight md:text-2xl">
                {it.title}
              </h3>

              <p class="mt-1 text-sm text-muted-foreground whitespace-pre-line">
                {it.institution}
              </p>

              <p class="mt-4 text-pretty text-base leading-relaxed text-muted-foreground">
                {it.description}
              </p>
            </article>
          </li>
        ))}
      </ul>
    </section>
  </PageContainer>
</Layout>
